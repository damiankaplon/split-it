{
  "mcpServers": {
    "postgres-local": {
      "command": "npx",
      "args": [
        "-y",
        "@toolbox-sdk/server",
        "--prebuilt=postgres",
        "--stdio"
      ],
      "env": {
        "POSTGRES_HOST": "localhost",
        "POSTGRES_PORT": "5432",
        "POSTGRES_DATABASE": "splitit",
        "POSTGRES_USER": "splitit",
        "POSTGRES_PASSWORD": "splitit"
      }
    },
    "brave-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "brave-mcp@latest",
        "--autoConnect"
      ],
      "env": {}
    },
    "idea": {
      "url": "http://127.0.0.1:64463/stream",
      "type": "http",
      "headers": {
        "IJ_MCP_LAUNCH_ORIGIN": "${IJ_MCP_LAUNCH_ORIGIN:-}"
      }
    }
  }
}