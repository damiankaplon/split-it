# Copy to .env.local to override. Defaults match backend/docker-compose.yaml.
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=split_it
VITE_KEYCLOAK_CLIENT_ID=localhost
# Path the frontend calls; in dev Vite proxies /api/* to BACKEND_URL with the /api prefix stripped.
VITE_API_BASE_URL=/api
BACKEND_URL=http://localhost:8080
