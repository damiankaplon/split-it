# Build settings of the Android and iOS apps (npm run build:mobile, i.e. vite build --mode mobile).
# The app is served from the device (https://localhost on Android, capacitor://localhost on iOS), so every
# URL must be absolute. To point a build elsewhere, override values in .env.mobile.local (git-ignored).
VITE_KEYCLOAK_URL=https://splitit-auth.damiankaplon.site
VITE_KEYCLOAK_REALM=split_it
# Public client with redirect URI pl.damiankaplon.splitit://auth, see the Mobile app section of README.md
VITE_KEYCLOAK_CLIENT_ID=splitit-mobile
VITE_API_BASE_URL=https://splitit.damiankaplon.site/api
# Invitation links open the web app
VITE_WEB_URL=https://splitit.damiankaplon.site
